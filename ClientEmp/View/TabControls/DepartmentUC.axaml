<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:ClientEmp.ViewModels.UserControlVM"
             x:DataType="vm:DepartmentUCVM"
             x:Class="ClientEmp.View.TabControls.DepartmentUC">
    <Border Background="Gray" Margin="8" CornerRadius="5">
        <Grid RowDefinitions="Auto, *">
            <Border Grid.Row="0"
                    BorderThickness="0.5"
                    BorderBrush="Black"
                    Padding="4"
                    CornerRadius="5"
                    Margin="12">
                <StackPanel>
                    <TextBlock Text="Добавление отдела" 
                               Foreground="Black" 
                               FontWeight="12" 
                               Margin="5"
                               FontSize="14" />
                    <TextBox Watermark="Введите имя отдела"
                             Text="{Binding Name}"
                             Margin="5, 5,5, 5"/>
                    <Button Content="Добавить" Margin="5,5,5,5" Command="{Binding AddDepartmentCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>