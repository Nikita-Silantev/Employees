<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ClientEmp.MainWindow"
        xmlns:vm="clr-namespace:ClientEmp.ViewModels"
        x:DataType="vm:MainWindowVM"
        xmlns:view="clr-namespace:ClientEmp.View.TabControls"
        Title="ClientEmp">
    <TabControl>
        <TabItem Header="Отделы">
            <view:DepartmentUC></view:DepartmentUC>
        </TabItem>
        <TabItem Header="Задачи">
            <view:TasksUC></view:TasksUC>
        </TabItem>
    </TabControl>
</Window>
